-- ==========================================
-- SCRIPT DE PURGA DEFINITIVA: ULTRA-AGRESIVA + ANTI-TEXTURAS
-- ==========================================

local g = game
local w = g.Workspace
local l = g.Lighting
local rs = g:GetService("ReplicatedStorage")
local starterGui = g:GetService("StarterGui")

-- 1. NOTIFICACIÓN DE ÉXITO
local function MostrarNotificacion()
    pcall(function()
        starterGui:SetCore("SendNotification", {
            Title = "Executed Script successfully",
            Text = "By chiqui",
            Icon = "rbxassetid://6034509993",
            Duration = 5
        })
    end)
end

-- 2. FUNCIÓN MAESTRA DE PURGA (Combina PurgaTotal y BorrarParticulas)
local function PurgaMaestra(v)
    local nameLower = v.Name:lower()

    -- A. Purga de Partículas (Por Clase y Nombre en todos los servicios)
    if v:IsA("ParticleEmitter") or v:IsA("Particle") or nameLower:match("particle") then
        v:Destroy()
        return
    end

    -- B. Borrado de Escombros Específicos (TSB Debris)
    if v:IsA("Part") and v.Name == "Debris" and v.Parent and v.Parent.Name == "Thrown" then
        v:Destroy()
        return
    end

    -- C. Borrado de Bloques sin Colisión (No Sólidos)
    -- Se ignora a los jugadores para no romper el juego
    if v:IsA("BasePart") and not v.Parent:FindFirstChild("Humanoid") and not v.Parent.Parent:FindFirstChild("Humanoid") then
        if v.CanCollide == false then
            v:Destroy()
            return
        end
    end

    -- D. Anti-Smoke, Fuego y Efectos de Línea
    if v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or 
       v:IsA("Trail") or v:IsA("Beam") or 
       nameLower:match("smoke") or nameLower:match("cloud") or nameLower:match("mist") then
        v:Destroy()
        return
    end

    -- E. Limpieza de Carpetas Pesadas (Resources en ReplicatedStorage)
    if v.Name == "Resources" and v.Parent == rs then
        v:Destroy()
        return
    end

    -- F. Borrado de MeshParts de Árboles (Trees)
    if v:IsA("MeshPart") and v.Parent and v.Parent.Name == "Tree" then
        v:Destroy()
        return
    end

    -- G. REMOCIÓN AGRESIVA DE TEXTURAS (Colores Sólidos / FPS Boost)
    if v:IsA("BasePart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
        -- Elimina Decals y Textures dentro de cualquier bloque
        for _, child in pairs(v:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                child:Destroy()
            end
        end
    elseif v:IsA("MeshPart") then
        v.Material = Enum.Material.Plastic
        v.TextureID = "" -- Quita la textura del modelo
    elseif v:IsA("SpecialMesh") then
        v.TextureId = "" -- Quita la textura de mallas especiales
    end
end

-- 3. ESCANEO GLOBAL INICIAL (En todos los archivos y servicios)
print("Iniciando Purga Maestra de Partículas, Texturas y Objetos...")

for _, servicio in pairs(g:GetChildren()) do
    pcall(function()
        local descendientes = servicio:GetDescendants()
        for i = 1, #descendientes do
            PurgaMaestra(descendientes[i])
        end
    end)
end

-- 4. MONITOR REAL-TIME (Anti-Spawn para nuevos objetos)
g.DescendantAdded:Connect(function(obj)
    pcall(function()
        -- Sin esperas largas para borrar al instante
        PurgaMaestra(obj)
    end)
end)

-- 5. AJUSTES DE ILUMINACIÓN EXTREMOS
pcall(function()
    l.GlobalShadows = false
    l.FogEnd = 9e9
    l.Brightness = 1
    if l:FindFirstChildOfClass("Atmosphere") then
        l:FindFirstChildOfClass("Atmosphere"):Destroy()
    end
    for _, effect in pairs(l:GetChildren()) do
        if effect:IsA("PostProcessEffect") then
            effect.Enabled = false
        end
    end
end)
-- 6. EJECUCIÓN FINAL
MostrarNotificacion()
print("--- PURGA MAESTRA COMPLETADA POR CHIQUI (Partículas y Texturas eliminadas) ---")
