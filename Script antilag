-- --- NUEVA FUNCIÓN: BORRADO DE NO SÓLIDOS Y PISOS DE COMBATE (TSB) ---
local function SuperOptimize(v)
    -- 1. Quitar VFX (Partículas, Trails, Explosiones)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
        v.Enabled = false
    elseif v:IsA("Explosion") then
        v.BlastPressure = 0
        v.BlastRadius = 0
        v.Visible = false
    end

    -- 2. BORRAR BLOQUES NO SÓLIDOS (Sin colisión)
    -- Se ignora a los jugadores para no romper el juego
    if v:IsA("BasePart") and not v.Parent:FindFirstChild("Humanoid") and not v.Parent.Parent:FindFirstChild("Humanoid") then
        if v.CanCollide == false then
            v:Destroy()
            return -- Si se borra, no seguimos procesando
        end
    end

    -- 3. BORRAR PISOS NUEVOS / BARRERAS DE GOLPES
    -- Detecta piezas creadas por habilidades (común en TSB)
    local destructionNames = {"Rock", "Ground", "Floor", "Wall", "Chunk", "Effect"}
    for _, name in pairs(destructionNames) do
        if v:IsA("BasePart") and v.Name:match(name) then
            task.wait() -- Delay mínimo para estabilidad
            v:Destroy()
            return
        end
    end

    -- 4. Aplicar material Plastic (Optimización VitorYT00 original)
    if v:IsA("BasePart") then
        v.Material = "Plastic"
        v.Reflectance = 0
        if v.Color == Color3.new(0, 0, 0) then
            v.Transparency = 1
        end
    elseif v:IsA("Decal") and decalsyeeted then
        v.Transparency = 1
    end
end

-- Limpieza Masiva Inicial
for _, v in pairs(g:GetDescendants()) do
    SuperOptimize(v)
end

-- Monitor en Tiempo Real (Borra lo nuevo al instante)
g.DescendantAdded:Connect(function(obj)
    SuperOptimize(obj)
end)

