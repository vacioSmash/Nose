-- --- PARTE 1: CONFIGURACIÓN INICIAL Y OPTIMIZACIÓN VISUAL ---
local decalsyeeted = true
local g = game
local w = g.Workspace
local l = g.Lighting
local t = w.Terrain
local RunService = g:GetService("RunService")
local Players = g:GetService("Players")

-- Exibe "VitorYT00" em azul por 10 segundos
local IntroGui = Instance.new("ScreenGui")
local IntroLabel = Instance.new("TextLabel")
IntroGui.Parent = g:GetService("CoreGui")
IntroLabel.Parent = IntroGui
IntroLabel.Size = UDim2.new(0, 400, 0, 50)
IntroLabel.Position = UDim2.new(0.5, -200, 0.5, -25)
IntroLabel.Text = "VitorYT00"
IntroLabel.FontSize = Enum.FontSize.Size24
IntroLabel.TextColor3 = Color3.new(0, 0, 1)
IntroLabel.BackgroundTransparency = 1

task.spawn(function()
    wait(10)
    IntroLabel.Text = "Atualização v1.0"
    wait(5)
    IntroLabel:Destroy()
    IntroGui:Destroy()
end)

-- Ajustes de Iluminación y Agua
l.Ambient = Color3.new(0, 1, 1)
t.WaterWaveSize = 0
t.WaterWaveSpeed = 0
t.WaterReflectance = 0
t.WaterTransparency = 0
l.GlobalShadows = false
l.FogEnd = 9e9
l.Brightness = 0

-- Calidad de Renderizado
settings().Rendering.QualityLevel = "Level01"

-- Limpieza Masiva de Objetos
for i,v in pairs(g:GetDescendants()) do
    if v:IsA("Part") or v:IsA("Union") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
        v.Material = "Plastic"
        v.Reflectance = 0
        if v.Color == Color3.new(1, 0, 0) then
            v.Color = Color3.new(0, 1, 1)
        elseif v.Color == Color3.new(0, 0, 0) then
            v.Transparency = 1
        end
    elseif v:IsA("Decal") and decalsyeeted then
        v.Transparency = 1
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
        v.Lifetime = NumberRange.new(0)
    elseif v:IsA("Explosion") then
        v.BlastPressure = 1
        v.BlastRadius = 1
    end
end

-- Desactivar Efectos de Post-procesamiento
for i,e in pairs(l:GetChildren()) do
    if e:IsA("BlurEffect") or e:IsA("SunRaysEffect") or e:IsA("ColorCorrectionEffect") or e:IsA("BloomEffect") or e:IsA("DepthOfFieldEffect") then
        e.Enabled = false
    end
end

