local replicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")

-- 1. Borrado instantáneo de Resources
local res = replicatedStorage:FindFirstChild("Resources")
if res then res:Destroy() end

-- 2. Tabla de búsqueda rápida (Diccionario para evitar lag)
local targets = {
    Walls = {["Part"] = true},
    Tree = {["MeshPart"] = true},
    Thrown = {["Debris"] = true, ["aa"] = true, ["Part"] = true, ["SmallDebris"] = true, ["DebrisGg"] = true},
    Grass = {["Union"] = true},
    Stadium = {["Stadium"] = true, ["Part"] = true}
}

-- Función eficiente para borrar
local function checkAndDestroy(obj)
    local pName = obj.Parent and obj.Parent.Name
    if pName and targets[pName] and targets[pName][obj.Name] then
        obj:Destroy()
    end
end

-- 3. Limpieza inicial rápida (Solo una vez al ejecutar)
for _, v in pairs(workspace:GetDescendants()) do
    checkAndDestroy(v)
end

-- 4. EL SECRETO: Escuchar solo cuando algo nuevo aparece (Cero lag)
workspace.DescendantAdded:Connect(function(obj)
    -- Esperamos un frame para que el objeto tenga nombre y padre definido
    task.wait() 
    if obj and obj.Parent then
        checkAndDestroy(obj)
    end
end)

-- 5. Mantener Resources borrado por si el juego lo recrea
task.spawn(function()
    while true do
        local r = replicatedStorage:FindFirstChild("Resources")
        if r then r:Destroy() end
        task.wait(2) -- Solo revisa cada 2 segundos, no afecta los FPS
    end
end)

-- 6. VIGILANTE DE EFECTOS NUEVOS (Combate)
-- Esto borra los efectos de "golpe" o "poderes" apenas aparecen
workspace.DescendantAdded:Connect(function(newObj)
    task.wait() -- Breve espera para que el objeto se cargue y detectarlo
    if not newObj:IsDescendantOf(player.Character) then
        if newObj:IsA("ParticleEmitter") or newObj:IsA("Trail") or newObj:IsA("Explosion") then
            newObj:Destroy()
        elseif newObj:IsA("Decal") or newObj:IsA("Texture") then
            newObj:Destroy()
        end
    end
end)


