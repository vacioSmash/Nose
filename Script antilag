local g = game
local w = g.Workspace
local l = g.Lighting
local rs = g:GetService("ReplicatedStorage")
local starterGui = g:GetService("StarterGui")

-- 1. NOTIFICACIÓN DE ÉXITO
local function MostrarNotificacion()
    pcall(function()
        starterGui:SetCore("SendNotification", {
            Title = "Executed Script successfully",
            Text = "By chiqui",
            Icon = "rbxassetid://6034509993",
            Duration = 5
        })
    end)
end

-- 2. FUNCIÓN MAESTRA DE PURGA (Ultra Agresiva)
local function PurgaTotal(v)
    local nameLower = v.Name:lower()

    -- A. Borrado de Escombros Específicos (TSB Debris)
    if v:IsA("Part") and v.Name == "Debris" and v.Parent and v.Parent.Name == "Thrown" then
        v:Destroy()
        return
    end

    -- B. Borrado de Bloques sin Colisión (No Sólidos)
    -- Evitamos borrar a los jugadores y objetos esenciales del personaje
    if v:IsA("BasePart") and not v.Parent:FindFirstChild("Humanoid") and not v.Parent.Parent:FindFirstChild("Humanoid") then
        if v.CanCollide == false then
            v:Destroy()
            return
        end
    end

    -- C. Anti-Smoke, Partículas y Efectos de Línea
    if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or 
       v:IsA("Trail") or v:IsA("Beam") or nameLower:match("particle") or 
       nameLower:match("smoke") or nameLower:match("cloud") or nameLower:match("mist") then
        v:Destroy()
        return
    end

    -- D. Borrar Carpeta Resources en ReplicatedStorage
    if v.Name == "Resources" and v.Parent == rs then
        v:Destroy()
        return
    end

    -- E. Borrar MeshParts de Árboles
    if v:IsA("MeshPart") and v.Parent and v.Parent.Name == "Tree" then
        v:Destroy()
        return
    end

    -- F. REMOCIÓN DE TEXTURAS (Colores Sólidos y Plastic)
    if v:IsA("BasePart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
        -- Si tiene texturas hijas, borrarlas
        for _, child in pairs(v:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                child:Destroy()
            end
        end
    elseif v:IsA("MeshPart") then
        v.TextureID = ""
    elseif v:IsA("SpecialMesh") then
        v.TextureId = ""
    end
end

-- 3. ESCANEO GLOBAL PROFUNDO (Todos los servicios)
print("Iniciando Purga Máxima...")

for _, servicio in pairs(g:GetChildren()) do
    pcall(function()
        local descendientes = servicio:GetDescendants()
        for i = 1, #descendientes do
            PurgaTotal(descendientes[i])
        end
    end)
end

-- 4. MONITOR REAL-TIME INSTANTÁNEO (Para bloqueos recién creados)
g.DescendantAdded:Connect(function(obj)
    pcall(function()
        -- Sin esperas para máxima agresividad
        PurgaTotal(obj)
    end)
end)

-- 5. AJUSTES DE ILUMINACIÓN EXTREMOS
pcall(function()
    l.GlobalShadows = false
    l.FogEnd = 9e9
    l.Brightness = 1
    if l:FindFirstChildOfClass("Atmosphere") then
        l:FindFirstChildOfClass("Atmosphere"):Destroy()
    end
    for _, effect in pairs(l:GetChildren()) do
        if effect:IsA("PostProcessEffect") then
            effect.Enabled = false
        end
    end
end)

-- 6. EJECUCIÓN
MostrarNotificacion()
print("--- PURGA AGRESIVA COMPLETADA POR CHIQUI ---")
