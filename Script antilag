-- ==========================================
-- SCRIPT DE PURGA TOTAL + NOTIFICACIÓN
-- ==========================================

local g = game
local w = g.Workspace
local rs = g:GetService("ReplicatedStorage")
local starterGui = g:GetService("StarterGui")

-- 1. FUNCIÓN DE NOTIFICACIÓN (Estilo Amistad/Sistema)
local function MostrarNotificacion()
    starterGui:SetCore("SendNotification", {
        Title = "Executed Script successfully",
        Text = "By chiqui",
        Icon = "rbxassetid://6034509993", -- Icono de check/escudo
        Duration = 5
    })
end

-- 2. FUNCIÓN MAESTRA DE LIMPIEZA
local function LimpiezaExtrema(v)
    -- A. Borrar Carpeta Resources (específicamente en ReplicatedStorage)
    if v:IsA("Folder") and v.Name == "Resources" and v.Parent == rs then
        v:Destroy()
        return
    end

    -- B. Borrar todos los archivos Particle (por clase y nombre)
    if v:IsA("ParticleEmitter") or v:IsA("Particle") or v.Name:lower():match("particle") then
        v:Destroy()
        return
    end

    -- C. Borrar efectos de línea (Beams, Trails y LineHandles)
    if v:IsA("Trail") or v:IsA("Beam") or v:IsA("LineHandleAdornment") then
        v:Destroy()
        return
    end

    -- D. Borrar MeshParts que tienen como padre a "Tree"
    if v:IsA("MeshPart") and v.Parent and v.Parent.Name == "Tree" then
        v:Destroy()
        return
    end
end

-- 3. ESCANEO GLOBAL (En todos los archivos y carpetas del juego)
print("Iniciando escaneo global de archivos...")

for _, servicio in pairs(g:GetChildren()) do
    pcall(function()
        -- Usamos GetDescendants para no dejar ni una carpeta sin revisar
        for _, obj in pairs(servicio:GetDescendants()) do
            LimpiezaExtrema(obj)
        end
    end)
end

-- 4. MONITOR EN TIEMPO REAL (Para lo que aparezca después)
g.DescendantAdded:Connect(function(obj)
    pcall(function()
        task.wait() -- Breve espera para que el motor asigne las propiedades
        LimpiezaExtrema(obj)
    end)
end)

-- 5. EJECUCIÓN DE NOTIFICACIÓN
MostrarNotificacion()

print("--- LIMPIEZA COMPLETADA POR CHIQUI ---")
